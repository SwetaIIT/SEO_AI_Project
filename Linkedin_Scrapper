            "        <a class=\"base-card__full-link absolute top-0 right-0 bottom-0 left-0 p-0 z-[2] outline-offset-[4px]\" href=\"https://www.linkedin.com/posts/oliviabaud_literally-i-always-stop-to-smell-the-roses-activity-7449861575601094657-jb76\" data-tracking-control-name=\"public_profile__reactions\" data-tracking-will-navigate=\"\">\n",
